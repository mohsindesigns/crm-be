{
  "name": "cadence-backend",
  "version": "1.0.0",
  "description": "Agency Operations Platform — REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:seed": "node src/seeders/seed.js",
    "db:seed:qa": "node src/seeders/seedQaDemo.js",
    "email:test": "node src/scripts/testEmail.js",
    "db:reset": "sequelize-cli db:migrate:undo:all && sequelize-cli db:migrate && node src/seeders/seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^6.9.8",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.4",
    "sequelize": "^6.35.2",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "uuid": "^9.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "sequelize-cli": "^6.6.2"
  }
}
