NODE_ENV=development
PORT=5000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cadence_crm
DB_USER=root
DB_PASSWORD=

# JWT — generate distinct random secrets per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Never reuse the same value across JWT_SECRET / JWT_REFRESH_SECRET / MEDIA_API_SECRET,
# and never reuse a dev secret in production.
JWT_SECRET=replace-with-a-unique-random-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace-with-a-different-unique-random-secret
JWT_REFRESH_EXPIRES_IN=30d

# Frontend URL — used for CORS and for building links in emails (invites,
# password resets, portal invites). Must be the real public frontend URL in
# production (e.g. https://app.yourdomain.com), not localhost.
FRONTEND_URL=http://localhost:3000

# File uploads (local legacy, prefer media server below)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20

# Media server — runs separately (Source Code/media/). MEDIA_API_SECRET must
# match API_SECRET in media/.env exactly, but must NOT match JWT_SECRET/
# JWT_REFRESH_SECRET above — use its own unique random value.
MEDIA_URL=http://localhost:3002
MEDIA_API_SECRET=replace-with-a-unique-random-secret

# Invoice PDF assets (optional) — override where the logo/signature images used
# on generated invoice PDFs are read from. Defaults to assets/logo.png and
# assets/signature.png in the backend repo, so these only need setting if you
# want to point at different files without replacing the committed ones.
# LOGO_IMAGE_PATH=
# SIGNATURE_IMAGE_PATH=

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@yourdomain.com

# Initial super admin (used by seed only)
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@mohsindesigns.com
SEED_ADMIN_PASSWORD=Admin@123
SEED_ORG_NAME=Mohsin Designs
SEED_ORG_SUBDOMAIN=mohsindesigns
SEED_BRAND_NAME=Mohsin Designs Project Management
SEED_BRAND_COLOR=#0B1D5E

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Card payments from the client portal. When a client picks "Credit / Debit Card"
# on an invoice we create a REAL Stripe Invoice (customer + line items, finalized)
# and redirect them to its hosted payment page; Stripe then calls the webhook
# below, which records the Payment and flips our invoice to `paid` automatically.
#
# Start with the SANDBOX (test-mode) keys — every value below is swappable for the
# live equivalents later without any code change.
#
#   Secret key      → Stripe Dashboard → Developers → API keys → "Secret key"
#                     Test mode starts sk_test_… ; live starts sk_live_…
#   Webhook secret  → Developers → Webhooks → add endpoint
#                       URL:    <your API origin>/api/stripe/webhook
#                       Events: invoice.paid, invoice.payment_succeeded,
#                               invoice.payment_failed, invoice.marked_uncollectible,
#                               invoice.voided
#                     then copy the "Signing secret" (whsec_…).
#                     For local testing instead run:
#                       stripe listen --forward-to localhost:5000/api/stripe/webhook
#                     and use the whsec_… that command prints.
#
# ONLY the credentials live here. Everything else about card payments — whether
# they're switched on, the processing fee per currency, how long an invoice stays
# payable — is managed in Admin → Payments, so it can be changed without a deploy.
#
# Credentials stay in the environment on purpose: the secret key is a bearer
# credential (anyone holding it can move money), and a database column would put
# it in every backup, replica and stray `SELECT *`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Only used before an admin has saved anything in Admin → Payments; once they
# have, the panel's toggle is authoritative and this is ignored.
STRIPE_ENABLED=false
